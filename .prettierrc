{
  "singleQuote": true,
  "trailingComma": "none",
  "printWidth": 100,
  "plugins": ["prettier-plugin-svelte", "prettier-plugin-tailwindcss"],
  "overrides": [
    {
      "files": "*.svelte",
      "options": {
        "parser": "svelte"
      }
    },
    {
      "files": "site/**",
      "options": {
        "tailwindStylesheet": "./site/src/app.css"
      }
    }
  ],
  "tailwindStylesheet": "./src/app.css"
}
